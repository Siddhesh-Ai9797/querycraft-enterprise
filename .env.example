DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/chinook
OPENAI_API_KEY=sk-your-key-here
INFERENCE_BACKEND=local
# Fine tuned model servers. INFERENCE_BACKEND can be local, vllm, llamacpp, modal or openai.
VLLM_URL=http://localhost:8001/v1
LLAMACPP_URL=http://localhost:8002/v1
MODAL_URL=https://your-workspace--querycraft-sql-serve.modal.run/v1
MODAL_API_KEY=same-value-as-the-querycraft-vllm-secret
# Baseline model used when INFERENCE_BACKEND=openai
OPENAI_SQL_MODEL=gpt-3.5-turbo
